{
  "info": {
    "_postman_id": "3e60380f-b43b-4a82-a46a-dentalpay-person3",
    "name": "DentalPay - Person 3 Scheduling & Reminders",
    "description": "Run requests from top to bottom. Local mock auth and mock reminder sending are used by default.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "clinicId", "value": "60c72b2f9b1d8b2bad000001" },
    { "key": "userId", "value": "60c72b2f9b1d8b2bad000002" },
    { "key": "patientId", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "reminderId", "value": "" },
    { "key": "startAt", "value": "" },
    { "key": "endAt", "value": "" },
    { "key": "demoPhone", "value": "" }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'x-clinic-id', value: pm.collectionVariables.get('clinicId') });",
          "pm.request.headers.upsert({ key: 'x-user-id', value: pm.collectionVariables.get('userId') });",
          "pm.request.headers.upsert({ key: 'x-user-role', value: 'admin' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "02 - Create Demo Patient",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('demoPhone', '+92300' + String(Date.now()).slice(-7));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Patient created', () => pm.expect(pm.response.code).to.eql(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('patientId', body._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Scheduling Demo Patient\",\n  \"phone\": \"{{demoPhone}}\",\n  \"email\": \"schedule.demo@example.com\",\n  \"age\": 30,\n  \"gender\": \"female\",\n  \"status\": \"uncleared\"\n}"
        },
        "url": "{{baseUrl}}/api/patients"
      }
    },
    {
      "name": "03 - Create Appointment",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date();",
              "start.setDate(start.getDate() + 2);",
              "start.setHours(9, 0, 0, 0);",
              "const end = new Date(start.getTime() + 30 * 60 * 1000);",
              "pm.collectionVariables.set('startAt', start.toISOString());",
              "pm.collectionVariables.set('endAt', end.toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Appointment created', () => pm.expect(pm.response.code).to.eql(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('appointmentId', body._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"doctorId\": \"{{userId}}\",\n  \"doctorName\": \"Dr. Sarah Chan\",\n  \"title\": \"Dental consultation\",\n  \"treatmentName\": \"Routine checkup\",\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\",\n  \"timezone\": \"Asia/Karachi\",\n  \"status\": \"confirmed\",\n  \"notes\": \"Postman demo appointment\"\n}"
        },
        "url": "{{baseUrl}}/api/appointments"
      }
    },
    {
      "name": "04 - Verify Conflict Check (expects 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Overlapping doctor visit is blocked', () => pm.expect(pm.response.code).to.eql(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"doctorId\": \"{{userId}}\",\n  \"doctorName\": \"Dr. Sarah Chan\",\n  \"title\": \"Overlapping appointment\",\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\"\n}"
        },
        "url": "{{baseUrl}}/api/appointments"
      }
    },
    {
      "name": "05 - List Appointments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/appointments?status=all&limit=100"
      }
    },
    {
      "name": "06 - Patient Next Visit",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/appointments/patient/{{patientId}}/next"
      }
    },
    {
      "name": "07 - Sync Visit and Payment Reminders",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"sms\",\n  \"daysAhead\": 7\n}"
        },
        "url": "{{baseUrl}}/api/reminders/sync"
      }
    },
    {
      "name": "08 - Create Custom Reminder",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Custom reminder created', () => pm.expect(pm.response.code).to.eql(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('reminderId', body._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"channel\": \"sms\",\n  \"message\": \"DentalPay test reminder from Postman.\",\n  \"scheduledFor\": \"{{startAt}}\"\n}"
        },
        "url": "{{baseUrl}}/api/reminders"
      }
    },
    {
      "name": "09 - Send Reminder (mock mode)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reminder sent once', () => pm.expect(pm.response.code).to.eql(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/reminders/{{reminderId}}/send"
      }
    },
    {
      "name": "10 - Re-send Same Reminder (expects 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate send is blocked', () => pm.expect(pm.response.code).to.eql(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/reminders/{{reminderId}}/send"
      }
    },
    {
      "name": "11 - Scheduling Dashboard",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/scheduling/dashboard?from={{startAt}}&to={{endAt}}"
      }
    },
    {
      "name": "12 - Scheduling Report",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/scheduling/reports?from=2026-01-01T00:00:00.000Z&to=2028-01-01T00:00:00.000Z"
      }
    },
    {
      "name": "13 - Cancel Appointment",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Postman cleanup\"\n}"
        },
        "url": "{{baseUrl}}/api/appointments/{{appointmentId}}/cancel"
      }
    }
  ]
}
